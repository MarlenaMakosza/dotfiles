{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "edit": "ask",
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "rm -rf*": "deny",
      "sudo *": "deny"
    }
  },
  "instructions": [
    "CONTRIBUTING.md",
    "docs/**/*.md",
    "packages/*/AGENTS.md"
  ],
  "mcp": {
      "codebase-memory-mcp": {
          "enabled": true,
          "type": "local",
          "command": [
              "/home/lenerystia/.local/bin/codebase-memory-mcp"
          ]
      },
      "postgres": {
          "type": "local",
          "command": [
            "uvx",
            "postgres-mcp",
            "--access-mode=restricted"
          ],
          "environment": {
            "DATABASE_URI": "postgresql://root:mysecretpassword@localhost:5432/local"
          },
          "enabled": true,
          "timeout": 60000
        },
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6_ablit": {
          "name": "huihui_ai/Qwen3.6-abliterated:35b"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3_coder_next_ablit": {
          "name": "huihui-ai_qwen3-coder-next-abliterated"
        },
        "c07b9268d97d8ba09d0529980627f3bd70f5f90a":{
          "name": "qwen-qwen3-next-80b-a3b-instruct"
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3coder_bartkowski_hui": {
          "name": "Qwen3 Coder Next Abliterated — llama.cpp",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  }
}
