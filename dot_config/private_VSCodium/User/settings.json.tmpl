    "yaml.schemas": {
        "file:///home/lenerystia/.vscode-oss/extensions/continue.continue-2.0.0-linux-x64/config-yaml-schema.json": [
            ".continue/**/*.yaml"
        ]
    },
    "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
